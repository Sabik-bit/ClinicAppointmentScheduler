<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GUI.MainWindow"
        Title="Clinic Appointment Scheduler"
        Width="1050"
        Height="720"
        Background="#F1F5F9">

    <Grid RowDefinitions="80,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <TextBlock Text="Clinic Appointment Scheduler"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="220,*">

            <!-- MENU -->
            <Border Grid.Column="0"
                    Background="#1E293B"
                    Padding="20">

                <StackPanel Spacing="15">

                    <TextBlock Text="MENU"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="Bold"/>

                    <Button Content="Patients"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="PatientsButton_Click"/>

                    <Button Content="Doctors"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="DoctorsButton_Click"/>

                    <Button Content="Appointments"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="AppointmentsButton_Click"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Background="#475569"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="DashboardButton_Click"/>

                </StackPanel>

            </Border>

            <!-- CONTENT -->
            <Grid Grid.Column="1"
                  Background="#F8FAFC">

                <!-- DASHBOARD -->
                <ScrollViewer x:Name="DashboardPanel">

                    <StackPanel Margin="35"
                                Spacing="22">

                        <TextBlock Text="Dashboard"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Welcome to the Clinic Appointment Scheduler"
                                   FontSize="18"
                                   Foreground="#475569"/>

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="25">

                            <StackPanel Spacing="8">

                                <TextBlock Text="Appointment Management System"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Manage patients, doctors and clinic appointments."
                                           FontSize="15"
                                           Foreground="#475569"/>

                            </StackPanel>

                        </Border>

                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="15">

                            <Border Grid.Column="0"
                                    Background="#DBEAFE"
                                    CornerRadius="10"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="Patients"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#1D4ED8"/>

                                    <TextBlock Text="Manage patient records"
                                               Foreground="#1E3A8A"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="1"
                                    Background="#DCFCE7"
                                    CornerRadius="10"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="Doctors"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#15803D"/>

                                    <TextBlock Text="Manage clinic doctors"
                                               Foreground="#166534"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Background="#FFEDD5"
                                    CornerRadius="10"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="Appointments"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#C2410C"/>

                                    <TextBlock Text="Book and manage appointments"
                                               Foreground="#9A3412"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                            </Border>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>


                <!-- PATIENTS -->
                <ScrollViewer x:Name="PatientsPanel"
                              IsVisible="False">

                    <StackPanel Margin="35"
                                Spacing="20">

                        <TextBlock Text="Patient Management"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Register and view clinic patients."
                                   Foreground="#475569"
                                   FontSize="16"/>

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Register New Patient"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Patient ID"
                                           Foreground="#334155"/>

                                <TextBox x:Name="PatientIdTextBox"
                                         PlaceholderText="Example: 100"/>

                                <TextBlock Text="Full Name"
                                           Foreground="#334155"/>

                                <TextBox x:Name="PatientNameTextBox"
                                         PlaceholderText="Enter full name"/>

                                <TextBlock Text="Phone"
                                           Foreground="#334155"/>

                                <TextBox x:Name="PatientPhoneTextBox"
                                         PlaceholderText="Enter phone number"/>

                                <TextBlock Text="Email"
                                           Foreground="#334155"/>

                                <TextBox x:Name="PatientEmailTextBox"
                                         PlaceholderText="Enter email address"/>

                                <Button Content="Add Patient"
                                        Width="140"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#2563EB"
                                        Foreground="White"
                                        Click="AddPatientButton_Click"/>

                                <TextBlock x:Name="PatientStatusText"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Registered Patients"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <Border Background="#DBEAFE"
                                CornerRadius="10"
                                Padding="15">

                            <StackPanel x:Name="PatientListPanel"
                                        Spacing="8"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>


                <!-- DOCTORS -->
                <ScrollViewer x:Name="DoctorsPanel"
                              IsVisible="False">

                    <StackPanel Margin="35"
                                Spacing="20">

                        <TextBlock Text="Doctor Management"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Register and view clinic doctors."
                                   Foreground="#475569"
                                   FontSize="16"/>

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Register New Doctor"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Doctor ID"
                                           Foreground="#334155"/>

                                <TextBox x:Name="DoctorIdTextBox"
                                         PlaceholderText="Example: 200"/>

                                <TextBlock Text="Doctor Name"
                                           Foreground="#334155"/>

                                <TextBox x:Name="DoctorNameTextBox"
                                         PlaceholderText="Enter doctor name"/>

                                <TextBlock Text="Speciality"
                                           Foreground="#334155"/>

                                <TextBox x:Name="DoctorSpecialityTextBox"
                                         PlaceholderText="Example: General Practice"/>

                                <Button Content="Add Doctor"
                                        Width="140"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#16A34A"
                                        Foreground="White"
                                        Click="AddDoctorButton_Click"/>

                                <TextBlock x:Name="DoctorStatusText"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Registered Doctors"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <Border Background="#DCFCE7"
                                CornerRadius="10"
                                Padding="15">

                            <StackPanel x:Name="DoctorListPanel"
                                        Spacing="8"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>


                <!-- APPOINTMENTS -->
                <ScrollViewer x:Name="AppointmentsPanel"
                              IsVisible="False">

                    <StackPanel Margin="35"
                                Spacing="20">

                        <TextBlock Text="Appointment Management"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Book, cancel and reschedule clinic appointments."
                                   Foreground="#475569"
                                   FontSize="16"/>


                        <!-- BOOK -->
                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Book New Appointment"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Appointment ID"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentIdTextBox"
                                         PlaceholderText="Example: 500"/>

                                <TextBlock Text="Patient ID"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentPatientIdTextBox"
                                         PlaceholderText="Enter registered patient ID"/>

                                <TextBlock Text="Doctor ID"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentDoctorIdTextBox"
                                         PlaceholderText="Enter registered doctor ID"/>

                                <TextBlock Text="Appointment Date"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentDateTextBox"
                                         PlaceholderText="Example: 05/10/2026"/>

                                <TextBlock Text="Appointment Time"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentTimeTextBox"
                                         PlaceholderText="Example: 10:30 AM"/>

                                <TextBlock Text="Reason"
                                           Foreground="#334155"/>

                                <TextBox x:Name="AppointmentReasonTextBox"
                                         PlaceholderText="Example: General check-up"/>

                                <Button Content="Book Appointment"
                                        Width="170"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#2563EB"
                                        Foreground="White"
                                        Click="AddAppointmentButton_Click"/>

                                <TextBlock x:Name="AppointmentStatusText"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- CANCEL -->
                        <Border Background="#FEF2F2"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Cancel Appointment"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#B91C1C"/>

                                <TextBlock Text="Appointment ID"
                                           Foreground="#7F1D1D"/>

                                <TextBox x:Name="CancelAppointmentIdTextBox"
                                         PlaceholderText="Enter appointment ID to cancel"/>

                                <Button Content="Cancel Appointment"
                                        Width="180"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#DC2626"
                                        Foreground="White"
                                        Click="CancelAppointmentButton_Click"/>

                                <TextBlock x:Name="CancelStatusText"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- RESCHEDULE -->
                        <Border Background="#FFF7ED"
                                BorderBrush="#FDBA74"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Reschedule Appointment"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#C2410C"/>

                                <TextBlock Text="Appointment ID"
                                           Foreground="#7C2D12"/>

                                <TextBox x:Name="RescheduleAppointmentIdTextBox"
                                         PlaceholderText="Enter appointment ID"/>

                                <TextBlock Text="New Date"
                                           Foreground="#7C2D12"/>

                                <TextBox x:Name="RescheduleDateTextBox"
                                         PlaceholderText="Example: 10/10/2026"/>

                                <TextBlock Text="New Time"
                                           Foreground="#7C2D12"/>

                                <TextBox x:Name="RescheduleTimeTextBox"
                                         PlaceholderText="Example: 2:30 PM"/>

                                <Button Content="Reschedule Appointment"
                                        Width="200"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#EA580C"
                                        Foreground="White"
                                        Click="RescheduleAppointmentButton_Click"/>

                                <TextBlock x:Name="RescheduleStatusText"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- APPOINTMENT LIST -->
                        <TextBlock Text="Appointments"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <Border Background="#E0F2FE"
                                BorderBrush="#7DD3FC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">

                            <StackPanel x:Name="AppointmentListPanel"
                                        Spacing="8"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>