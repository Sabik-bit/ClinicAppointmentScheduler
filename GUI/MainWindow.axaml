<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GUI.MainWindow"
        Title="Clinic Appointment Scheduler"
        Width="900"
        Height="600"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#2563EB"
                Padding="20">

            <TextBlock Text="Clinic Appointment Scheduler"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              ColumnDefinitions="220,*">

            <!-- LEFT NAVIGATION -->
            <Border Grid.Column="0"
                    Background="#1E293B"
                    Padding="15">

                <StackPanel Spacing="15">

                    <TextBlock Text="MENU"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="5,5,0,5"/>

                    <Button Content="Patients"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="PatientsButton_Click"/>

                    <Button Content="Doctors"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button Content="Appointments"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Background="#475569"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="DashboardButton_Click"/>

                </StackPanel>

            </Border>

            <!-- RIGHT SIDE -->
            <Grid Grid.Column="1">

                <!-- ========================= -->
                <!-- DASHBOARD -->
                <!-- ========================= -->

                <StackPanel x:Name="DashboardPanel"
                            Margin="30"
                            Spacing="20">

                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Welcome to the Clinic Appointment Scheduler"
                               FontSize="18"
                               Foreground="#475569"/>

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25">

                        <StackPanel Spacing="10">

                            <TextBlock Text="Appointment Management System"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Use the menu to manage patients, doctors and clinic appointments."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- DASHBOARD CARDS -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="15">

                        <!-- PATIENT CARD -->
                        <Border Grid.Column="0"
                                Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="Patients"
                                           FontWeight="Bold"
                                           Foreground="#1E40AF"/>

                                <TextBlock Text="Manage patient records"
                                           Foreground="#475569"
                                           FontSize="13"/>

                            </StackPanel>

                        </Border>

                        <!-- DOCTOR CARD -->
                        <Border Grid.Column="1"
                                Background="#F0FDF4"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="Doctors"
                                           FontWeight="Bold"
                                           Foreground="#166534"/>

                                <TextBlock Text="Manage clinic doctors"
                                           Foreground="#475569"
                                           FontSize="13"/>

                            </StackPanel>

                        </Border>

                        <!-- APPOINTMENT CARD -->
                        <Border Grid.Column="2"
                                Background="#FFF7ED"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="Appointments"
                                           FontWeight="Bold"
                                           Foreground="#9A3412"/>

                                <TextBlock Text="Schedule appointments"
                                           Foreground="#475569"
                                           FontSize="13"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>


                <!-- ========================= -->
                <!-- PATIENT MANAGEMENT -->
                <!-- ========================= -->

                <ScrollViewer x:Name="PatientsPanel"
                              IsVisible="False">

                    <StackPanel Margin="30"
                                Spacing="15">

                        <TextBlock Text="Patient Management"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Add and manage clinic patient records."
                                   FontSize="16"
                                   Foreground="#64748B"/>

                        <!-- ADD PATIENT FORM -->
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Add New Patient"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <!-- PATIENT ID -->

                                <TextBlock Text="Patient ID"
                                           Foreground="#475569"/>

                                <TextBox x:Name="PatientIdTextBox"
                                         Watermark="Enter patient ID"/>

                                <!-- FULL NAME -->

                                <TextBlock Text="Full Name"
                                           Foreground="#475569"/>

                                <TextBox x:Name="PatientNameTextBox"
                                         Watermark="Enter full name"/>

                                <!-- PHONE -->

                                <TextBlock Text="Phone"
                                           Foreground="#475569"/>

                                <TextBox x:Name="PatientPhoneTextBox"
                                         Watermark="Enter phone number"/>

                                <!-- EMAIL -->

                                <TextBlock Text="Email"
                                           Foreground="#475569"/>

                                <TextBox x:Name="PatientEmailTextBox"
                                         Watermark="Enter email address"/>

                                <!-- ADD PATIENT BUTTON -->

                                <Button Content="Add Patient"
                                        Background="#2563EB"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Padding="20,10"
                                        Margin="0,5,0,0"
                                        Click="AddPatientButton_Click"/>

                                <!-- STATUS MESSAGE -->

                                <TextBlock x:Name="PatientStatusText"
                                           Text=""
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- REGISTERED PATIENTS -->

                        <TextBlock Text="Registered Patients"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <Border Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel x:Name="PatientListPanel"
                                        Spacing="8">

                                <TextBlock x:Name="NoPatientsText"
                                           Text="Patient records will appear here."
                                           Foreground="#475569"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>