<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GUI.MainWindow"
        Title="Clinic Appointment Scheduler"
        Width="900"
        Height="600"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#2563EB"
                Padding="20">
            <TextBlock Text="Clinic Appointment Scheduler"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- LEFT MENU -->
            <Border Grid.Column="0"
                    Background="#1E293B"
                    Padding="15">

                <StackPanel Spacing="15">

                    <TextBlock Text="MENU"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="5,5,0,5"/>

                    <Button Content="Patients"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="PatientsButton_Click"/>

                    <Button Content="Doctors"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="DoctorsButton_Click"/>

                    <Button Content="Appointments"
                            Height="45"
                            Background="#334155"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="AppointmentsButton_Click"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Background="#475569"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="DashboardButton_Click"/>

                </StackPanel>

            </Border>

            <!-- RIGHT CONTENT -->
            <Grid Grid.Column="1">

                <!-- DASHBOARD -->
                <StackPanel x:Name="DashboardPanel"
                            Margin="30"
                            Spacing="20">

                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Welcome to the Clinic Appointment Scheduler"
                               FontSize="18"
                               Foreground="#475569"/>

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25">

                        <StackPanel Spacing="10">

                            <TextBlock Text="Appointment Management System"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Use the menu to manage patients, doctors and clinic appointments."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">

                        <Border Grid.Column="0"
                                Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="Patients"
                                           FontWeight="Bold"
                                           Foreground="#1E40AF"/>
                                <TextBlock Text="Manage patient records"
                                           Foreground="#475569"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#F0FDF4"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="Doctors"
                                           FontWeight="Bold"
                                           Foreground="#166534"/>
                                <TextBlock Text="Manage clinic doctors"
                                           Foreground="#475569"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFF7ED"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="Appointments"
                                           FontWeight="Bold"
                                           Foreground="#9A3412"/>
                                <TextBlock Text="Schedule appointments"
                                           Foreground="#475569"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                </StackPanel>

                <!-- PATIENTS -->
                <ScrollViewer x:Name="PatientsPanel"
                              IsVisible="False">

                    <StackPanel Margin="30" Spacing="15">

                        <TextBlock Text="Patient Management"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Add and manage clinic patient records."
                                   FontSize="16"
                                   Foreground="#64748B"/>

                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Add New Patient"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="Patient ID"/>
                                <TextBox x:Name="PatientIdTextBox"
                                         PlaceholderText="Enter patient ID"/>

                                <TextBlock Text="Full Name"/>
                                <TextBox x:Name="PatientNameTextBox"
                                         PlaceholderText="Enter full name"/>

                                <TextBlock Text="Phone"/>
                                <TextBox x:Name="PatientPhoneTextBox"
                                         PlaceholderText="Enter phone number"/>

                                <TextBlock Text="Email"/>
                                <TextBox x:Name="PatientEmailTextBox"
                                         PlaceholderText="Enter email address"/>

                                <Button Content="Add Patient"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Background="#2563EB"
                                        Foreground="White"
                                        Click="AddPatientButton_Click"/>

                                <TextBlock x:Name="PatientStatusText"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Registered Patients"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <Border Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel x:Name="PatientListPanel"
                                        Spacing="8">

                                <TextBlock x:Name="NoPatientsText"
                                           Text="Patient records will appear here."
                                           Foreground="#475569"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- DOCTORS -->
                <ScrollViewer x:Name="DoctorsPanel"
                              IsVisible="False">

                    <StackPanel Margin="30" Spacing="15">

                        <TextBlock Text="Doctor Management"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Add and manage clinic doctors."
                                   FontSize="16"
                                   Foreground="#64748B"/>

                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Add New Doctor"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="Doctor ID"/>
                                <TextBox x:Name="DoctorIdTextBox"
                                         PlaceholderText="Enter doctor ID"/>

                                <TextBlock Text="Doctor Name"/>
                                <TextBox x:Name="DoctorNameTextBox"
                                         PlaceholderText="Enter doctor name"/>

                                <TextBlock Text="Speciality"/>
                                <TextBox x:Name="DoctorSpecialityTextBox"
                                         PlaceholderText="Enter speciality"/>

                                <Button Content="Add Doctor"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Background="#2563EB"
                                        Foreground="White"
                                        Click="AddDoctorButton_Click"/>

                                <TextBlock x:Name="DoctorStatusText"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Registered Doctors"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <Border Background="#F0FDF4"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel x:Name="DoctorListPanel"
                                        Spacing="8">

                                <TextBlock x:Name="NoDoctorsText"
                                           Text="Doctor records will appear here."
                                           Foreground="#475569"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- APPOINTMENTS -->
                <ScrollViewer x:Name="AppointmentsPanel"
                              IsVisible="False">

                    <StackPanel Margin="30" Spacing="15">

                        <TextBlock Text="Appointment Management"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Schedule and view clinic appointments."
                                   FontSize="16"
                                   Foreground="#64748B"/>

                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Schedule New Appointment"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="Appointment ID"/>
                                <TextBox x:Name="AppointmentIdTextBox"
                                         PlaceholderText="Enter appointment ID"/>

                                <TextBlock Text="Patient Name"/>
                                <TextBox x:Name="AppointmentPatientTextBox"
                                         PlaceholderText="Enter patient name"/>

                                <TextBlock Text="Doctor Name"/>
                                <TextBox x:Name="AppointmentDoctorTextBox"
                                         PlaceholderText="Enter doctor name"/>

                                <TextBlock Text="Appointment Date"/>
                                <TextBox x:Name="AppointmentDateTextBox"
                                         PlaceholderText="Example: 03/10/2026"/>

                                <TextBlock Text="Appointment Time"/>
                                <TextBox x:Name="AppointmentTimeTextBox"
                                         PlaceholderText="Example: 10:30 AM"/>

                                <Button Content="Add Appointment"
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        Background="#2563EB"
                                        Foreground="White"
                                        Click="AddAppointmentButton_Click"/>

                                <TextBlock x:Name="AppointmentStatusText"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Scheduled Appointments"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <Border Background="#FFF7ED"
                                CornerRadius="8"
                                Padding="15">

                            <StackPanel x:Name="AppointmentListPanel"
                                        Spacing="8">

                                <TextBlock x:Name="NoAppointmentsText"
                                           Text="Appointments will appear here."
                                           Foreground="#475569"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>